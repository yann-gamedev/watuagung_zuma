APP_NAME="Desa Watuagung API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
DB_CONNECTION=sqlite
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_CHANNEL=stack
# Email status pemohon ditulis ke storage/logs saat lokal. Antrean diproses: php artisan queue:work --stop-when-empty
MAIL_MAILER=log
MAIL_FROM_ADDRESS=notifikasi@desawatuagung.com
MAIL_FROM_NAME="Pelayanan Desa Watuagung"
# Asal frontend untuk tautan di email (cek status, berhenti berlangganan).
SITE_URL=http://127.0.0.1:3000
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# false: semua jenis surat langsung ke petugas desa; akun Ketua RT/RW tidak dapat mengakses panel.
# true: DOMISILI, SKTM, KTP_KK melewati RT/RW; SKU tetap langsung ke petugas desa.
LETTER_NEIGHBORHOOD_APPROVAL=false
# URL halaman verifikasi publik yang dimuat di QR surat (ganti ke domain HTTPS frontend).
LETTER_VERIFY_URL=http://localhost:3000/verifikasi/
LETTER_KABUPATEN=PASURUAN
LETTER_KECAMATAN=PRIGEN
LETTER_ALAMAT_KANTOR="Jl. Taman Safari II No. 01 Desa Watuagung Kec. Prigen Tlp. (0343) 7660001 Kode Pos 67157"
LETTER_KEPALA_DESA="DIDIK HARIYANTO"
# Hari warga dapat mengunduh scan surat bertanda tangan sejak unggahan terakhir.
LETTER_DOWNLOAD_DAYS=30
# Masa simpan data pribadi permohonan COMPLETED/REJECTED (hari). Kosong = retensi mati sampai desa menetapkan angkanya.
RETENTION_APPLICATION_DAYS=
# Hapus file lampiran N hari setelah permohonan COMPLETED/REJECTED (bawaan 30). 0 = mati.
ATTACHMENT_RETENTION_DAYS=30
# Masa berlaku token petugas dalam menit (480 = 8 jam kerja).
SANCTUM_EXPIRATION=480

APP_NAME="Desa Watuagung API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
DB_CONNECTION=sqlite
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_CHANNEL=stack
MAIL_MAILER=log
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# URL halaman verifikasi publik yang dimuat di QR surat (ganti ke domain HTTPS frontend).
LETTER_VERIFY_URL=http://localhost:3000/verifikasi/
LETTER_KABUPATEN=PASURUAN
LETTER_KECAMATAN=PRIGEN
LETTER_ALAMAT_KANTOR="Jl. Taman Safari Indonesia II, Dusun Watuagung RT 001/RW 001"
LETTER_KEPALA_DESA="DIDIK HARIYANTO"
# Masa simpan data pribadi permohonan COMPLETED/REJECTED (hari). Kosong = retensi mati sampai desa menetapkan angkanya.
RETENTION_APPLICATION_DAYS=
# Masa berlaku token petugas dalam menit (480 = 8 jam kerja).
SANCTUM_EXPIRATION=480

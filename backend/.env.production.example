# Nama aplikasi untuk log dan CLI.
APP_NAME="Desa Watuagung API"
# Lingkungan server operasional.
APP_ENV=production
# dibuat SEKALI di server dengan php artisan key:generate, simpan cadangannya di luar server; JANGAN pernah dibuat ulang — data terenkripsi akan hilang
APP_KEY=
# Jangan tampilkan detail galat kepada publik.
APP_DEBUG=false
# Ganti <domain> dengan domain HTTPS desa tanpa garis miring akhir.
APP_URL=https://<domain>
# Zona waktu pelayanan dan penomoran tahunan surat.
APP_TIMEZONE=Asia/Jakarta
# Bahasa utama aplikasi.
APP_LOCALE=id
# Bahasa cadangan aplikasi.
APP_FALLBACK_LOCALE=en
# Hostinger Web Hosting: MySQL/MariaDB (driver mysql berlaku untuk keduanya). Untuk VPS: pgsql.
DB_CONNECTION=mysql
# Host dari hPanel → Database (biasanya localhost); bukan akses remote.
DB_HOST=localhost
# Port bawaan MySQL/MariaDB.
DB_PORT=3306
# Isi nama database dari hPanel (format u123456789_nama).
DB_DATABASE=
# Isi user database dari hPanel; jangan aktifkan Remote MySQL.
DB_USERNAME=
# Isi kata sandi hanya di server; jangan commit nilainya.
DB_PASSWORD=
# Sesi disimpan dalam tabel database hasil migration.
SESSION_DRIVER=database
# Cache dan rate limit memakai database.
CACHE_STORE=database
# Email status pemohon diantre di tabel jobs; cron tiap menit menjalankan queue:work (deploy/hostinger.md § H).
QUEUE_CONNECTION=database
# Rotasi log harian Laravel.
LOG_CHANNEL=daily
# Kurangi log produksi; tetap tinjau agar tidak memuat data pribadi.
LOG_LEVEL=warning
# Email notifikasi lewat SMTP Hostinger (smtp.hostinger.com, port 465 SSL/TLS; sumber:
# https://docs.hostinger.com/emails/setup-devices). Username = alamat kotak surat lengkap.
# Kata sandi kotak surat diisi di server saja. JANGAN aktifkan sebelum halaman /berhenti-email/ (E2) ter-deploy;
# sampai saat itu biarkan MAIL_MAILER=log.
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=notifikasi@desawatuagung.com
MAIL_FROM_NAME="Pelayanan Desa Watuagung"
# Asal situs warga untuk tautan di email (cek status, berhenti berlangganan); sama dengan APP_URL di Hostinger.
SITE_URL=https://<domain>
# Origin browser yang boleh memanggil API, dipisah koma, tanpa garis miring akhir: situs utama (sama dengan
# APP_URL) dan panel di subdomain (deploy/hostinger.md § N). Origin utama tetap dicantumkan (tidak berbahaya:
# permintaan same-origin tidak memakai CORS). Tanpa panel subdomain cukup https://<domain>. Hanya host utama atau
# subdomain langsungnya yang diterima app:preflight --production. SITE_URL TIDAK diubah ke subdomain.
FRONTEND_ORIGINS=https://<domain>,https://panel.<domain>
# Bawaan semua jenis surat langsung ke petugas; akses Ketua RT/RW nonaktif.
LETTER_NEIGHBORHOOD_APPROVAL=false
# URL halaman publik untuk QR surat.
LETTER_VERIFY_URL=https://<domain>/verifikasi/
# Identitas kabupaten dari .env.example; konfirmasi sebelum operasional.
LETTER_KABUPATEN=PASURUAN
# Identitas kecamatan dari .env.example.
LETTER_KECAMATAN=PRIGEN
# Alamat kantor publik dari .env.example, bukan alamat warga.
LETTER_ALAMAT_KANTOR="Jl. Taman Safari II No. 01 Desa Watuagung Kec. Prigen Tlp. (0343) 7660001 Kode Pos 67157"
# Penandatangan dari .env.example; perbarui bila pejabat berubah.
LETTER_KEPALA_DESA="DIDIK HARIYANTO"
# Hari warga dapat mengunduh scan surat bertanda tangan sejak unggahan terakhir.
LETTER_DOWNLOAD_DAYS=7
LETTER_VALIDITY_DAYS=7
# Kosong: retensi mati sampai desa menetapkan masa simpan dalam hari.
RETENTION_APPLICATION_DAYS=
# Hapus file lampiran (KTP/KK/pengantar) N hari setelah permohonan COMPLETED/REJECTED. 0 = mati.
ATTACHMENT_RETENTION_DAYS=30
# Masa berlaku token petugas dalam menit (8 jam).
SANCTUM_EXPIRATION=480
# BIARKAN KOSONG di produksi: URL media = APP_URL/storage, disajikan symlink public_html/storage → storage/app/public
# (Hostinger) atau alias Nginx /storage/ (VPS). Bila diisi wajib https dan sehost dengan APP_URL (app:preflight).
MEDIA_URL=
# Penyimpanan bawaan tetap privat untuk surat terenkripsi.
FILESYSTEM_DISK=local

# Nama aplikasi untuk log dan CLI.
APP_NAME="Desa Watuagung API"
# Lingkungan server operasional.
APP_ENV=production
# dibuat SEKALI di server dengan php artisan key:generate, simpan cadangannya di luar server; JANGAN pernah dibuat ulang — data terenkripsi akan hilang
APP_KEY=
# Jangan tampilkan detail galat kepada publik.
APP_DEBUG=false
# Ganti <domain> dengan domain HTTPS desa tanpa garis miring akhir.
APP_URL=https://<domain>
# Zona waktu pelayanan dan penomoran tahunan surat.
APP_TIMEZONE=Asia/Jakarta
# Bahasa utama aplikasi.
APP_LOCALE=id
# Bahasa cadangan aplikasi.
APP_FALLBACK_LOCALE=en
# PostgreSQL 16+ untuk produksi.
DB_CONNECTION=pgsql
# Database satu VPS, jangan buka port PostgreSQL ke internet.
DB_HOST=127.0.0.1
# Isi nama database khusus aplikasi di server.
DB_DATABASE=
# Isi user PostgreSQL khusus aplikasi di server.
DB_USERNAME=
# Isi kata sandi hanya di server; jangan commit nilainya.
DB_PASSWORD=
# Sesi disimpan dalam tabel database hasil migration.
SESSION_DRIVER=database
# Cache dan rate limit memakai database.
CACHE_STORE=database
# Belum ada job; tidak perlu queue worker.
QUEUE_CONNECTION=sync
# Rotasi log harian Laravel.
LOG_CHANNEL=daily
# Kurangi log produksi; tetap tinjau agar tidak memuat data pribadi.
LOG_LEVEL=warning
# R11 belum aktif; email hanya ditulis ke log, bukan dikirim.
MAIL_MAILER=log
# Origin frontend sama persis dengan APP_URL.
FRONTEND_ORIGINS=https://<domain>
# Bawaan semua jenis surat langsung ke petugas; akses Ketua RT/RW nonaktif.
LETTER_NEIGHBORHOOD_APPROVAL=false
# URL halaman publik untuk QR surat.
LETTER_VERIFY_URL=https://<domain>/verifikasi/
# Identitas kabupaten dari .env.example; konfirmasi sebelum operasional.
LETTER_KABUPATEN=PASURUAN
# Identitas kecamatan dari .env.example.
LETTER_KECAMATAN=PRIGEN
# Alamat kantor publik dari .env.example, bukan alamat warga.
LETTER_ALAMAT_KANTOR="Jl. Taman Safari II No. 01 Desa Watuagung Kec. Prigen Tlp. (0343) 7660001 Kode Pos 67157"
# Penandatangan dari .env.example; perbarui bila pejabat berubah.
LETTER_KEPALA_DESA="DIDIK HARIYANTO"
# Kosong: retensi mati sampai desa menetapkan masa simpan dalam hari.
RETENTION_APPLICATION_DAYS=
# Masa berlaku token petugas dalam menit (8 jam).
SANCTUM_EXPIRATION=480
# Kosong memakai APP_URL/storage; Nginx hanya boleh menyajikan media publik.
MEDIA_URL=
# Penyimpanan bawaan tetap privat untuk surat terenkripsi.
FILESYSTEM_DISK=local

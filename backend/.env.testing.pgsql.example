# Copy to .env.testing.pgsql and fill in the existing local test credentials.
# APP_KEY must be inherited from the existing local environment; do not generate a new key.
# WARNING: migrations and tests DELETE all data in watuagung_test.
APP_ENV=testing
APP_DEBUG=false
DB_CONNECTION=pgsql
DB_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=watuagung_test
DB_USERNAME=
DB_PASSWORD=
LOG_CHANNEL=null
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=4
BROADCAST_CONNECTION=null
CACHE_STORE=array
MAIL_MAILER=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array

# Ganti <domain>; URL ini masuk bundle browser saat build, bukan rahasia.
NEXT_PUBLIC_API_URL=https://<domain>/api/v1
# Produksi memakai API Laravel, bukan simulasi.
NEXT_PUBLIC_DEMO_MODE=false
# Jangan tampilkan konten contoh yang dikendalikan flag ini.
NEXT_PUBLIC_SHOW_SAMPLE_CONTENT=false
# Biarkan kosong sampai Google Form resmi desa siap.
NEXT_PUBLIC_COMPLAINT_FORM_URL=

# Ganti <domain>; URL ini masuk bundle browser saat build, bukan rahasia.
NEXT_PUBLIC_API_URL=https://<domain>/api/v1
# Produksi memakai API Laravel, bukan simulasi.
NEXT_PUBLIC_DEMO_MODE=false
# Jangan tampilkan konten contoh yang dikendalikan flag ini.
NEXT_PUBLIC_SHOW_SAMPLE_CONTENT=false
# Biarkan kosong sampai Google Form resmi desa siap.
NEXT_PUBLIC_COMPLAINT_FORM_URL=
# Origin publik (tanpa slash akhir) untuk canonical, sitemap, dan og:image absolut.
# Kosong atau tidak valid = halaman tidak diindeks (robots noindex), tanpa tebakan domain.
NEXT_PUBLIC_SITE_URL=https://desawatuagung.com
# Origin panel petugas di subdomain (tanpa slash akhir). HANYA untuk build yang di-deploy mode S
# (deploy/hostinger.md § N); kosong = tautan ke panel relatif, seperti sebelumnya.
NEXT_PUBLIC_ADMIN_URL=
# Token verifikasi Google Search Console; kosong = tag verifikasi tidak dirender.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

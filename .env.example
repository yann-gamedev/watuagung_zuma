# true = paksa demo, abaikan API URL. build:demo selalu memaksa true.
NEXT_PUBLIC_DEMO_MODE=false
# Kosong = mode simulasi. Isi dengan base URL Laravel sampai /api/v1, tanpa slash akhir.
# Contoh: http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_API_URL=
# Optional production canonical origin, used when replacing prototype metadata.
NEXT_PUBLIC_SITE_URL=
# Google Form pengaduan milik desa. Hanya diterima bila diawali https://forms.gle/
# atau https://docs.google.com/forms/; selain itu dianggap kosong dan tetap "Segera hadir".
# Contoh: https://forms.gle/ContohFormDesa
NEXT_PUBLIC_COMPLAINT_FORM_URL=
# Berita, agenda, dan pengumuman contoh. Kosong/true = tampil (perilaku lama).
# Produksi: false = keadaan kosong "Belum ada ... resmi" dan footer sumber resmi.
# build:demo selalu memaksa true. Label "contoh" persyaratan pelayanan tetap tampil.
NEXT_PUBLIC_SHOW_SAMPLE_CONTENT=true
